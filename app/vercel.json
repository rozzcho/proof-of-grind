{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-SERVER-HOST/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://REPLACE-WITH-SERVER-HOST/auth/:path*"
    }
  ]
}
