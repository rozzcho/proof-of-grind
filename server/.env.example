# Discord application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Role that unlocks the private Weekly Challenge channel
DISCORD_ROLE_ID=
# Voice channel where Weekly study time is counted (camera must be on)
DISCORD_VOICE_CHANNEL_ID=
# Biweekly has its own role and voice channel (needed once track 1 is in CHALLENGE_TRACKS)
DISCORD_BIWEEKLY_ROLE_ID=
DISCORD_BIWEEKLY_VOICE_CHANNEL_ID=
# Staff channel where /report outcomes are logged (optional)
DISCORD_REPORTS_CHANNEL_ID=
# Daily goal in seconds (10800 = 3h). Lower it for local testing.
DAILY_GOAL_SECONDS=10800
# Tracks this server runs (registration, time tracking, settlement), comma separated.
# 0 = Weekly, 1 = Biweekly, 2 = the short test track (10-minute challenges, five 2-minute days)
CHALLENGE_TRACKS=0
# How often counted time is written to the local database
FLUSH_INTERVAL_MS=30000

# Any long random string (cookie signing)
SESSION_SECRET=

# Where the site is served from; the Discord OAuth callback goes to APP_URL/auth/discord/callback
APP_URL=http://localhost:5173
RPC_URL=http://127.0.0.1:8899
PORT=8787

# Test SOL faucet (optional): how much a tester gets, once per Discord account
FAUCET_SOL=0.05

# Hosted deployments only:
# the faucet key as a JSON array, instead of server/.keys/faucet.json
# FAUCET_SECRET_KEY=[12,34,...]
# the verifier key as a JSON array, instead of server/.keys/verifier.json
# VERIFIER_SECRET_KEY=[12,34,...]
# where the time-tracking database lives (mount a volume there)
# DB_PATH=/data/grind.db
